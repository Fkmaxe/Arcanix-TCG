# Copier en .env puis remplir. Ne jamais commiter .env.
# Explication détaillée de chaque variable : docs/CONFIGURATION.md

# --- PostgreSQL ------------------------------------------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=pointsdb

# --- API -------------------------------------------------------------------------
# Secret de signature des sessions : `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=
JWT_EXPIRE_DAYS=7
# Origines autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000
# URL publique du site (liens envoyés par le bot, images des embeds)
FRONTEND_URL=http://localhost:3000
DEBUG=false
# IP locale de la VM Nginx (PAS celle de la VM Docker) : l'API lit alors la vraie IP des visiteurs.
# Méthode pour la trouver : docs/CONFIGURATION.md, section FORWARDED_ALLOW_IPS
FORWARDED_ALLOW_IPS=

# --- Emails (SMTP) — laisser SMTP_HOST vide pour désactiver -------------------------
# Mot de passe oublié, invitations par email, places libérées en liste d'attente
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Arcanix <no-reply@ton-domaine.fr>
# starttls (587) | ssl (465) | aucune (relais local)
SMTP_SECURITE=starttls

# --- Frontend (injecté au build) ---------------------------------------------------
# URL publique de l'API, vue depuis le navigateur
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Discord -----------------------------------------------------------------------
# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# Secret partagé entre l'API et le bot (valeur aléatoire, identique des deux côtés)
DISCORD_BOT_TOKEN=
# Serveur de l'asso : synchronisation immédiate des commandes (clic droit > Copier l'identifiant)
DISCORD_GUILD_ID=
# Salon des annonces automatiques (nouvelles séances, rappels J-1, podiums)
DISCORD_ANNONCES_CHANNEL_ID=
# Rôle à mentionner dans les annonces (optionnel)
DISCORD_ANNONCES_ROLE_ID=
# Rôles automatiques (clic droit sur le rôle > Copier l'identifiant)
# Membre : donné à /register et /lier. Top 3 : suit le classement du semestre en cours.
DISCORD_ROLE_MEMBRE_ID=
DISCORD_ROLE_TOP3_ID=
# Synchronisation périodique (top 3, rattrapage du rôle Membre) : nécessite l'intent
# « Server Members » dans le Developer Portal. Automatique si DISCORD_ROLE_TOP3_ID est défini.
DISCORD_SYNC_ROLES=false
# Webhook optionnel : notification quand des présences sont validées depuis le site
DISCORD_WEBHOOK_URL=
